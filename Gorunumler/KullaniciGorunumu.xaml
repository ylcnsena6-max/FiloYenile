<Window x:Class="FiloYenile.Gorunumler.KullaniciGorunumu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kullanıcı Bilgileri"
        Height="330"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111C30">

    <Border Margin="18"
            Padding="24"
            Background="#1B2A45"
            BorderBrush="#405879"
            BorderThickness="1"
            CornerRadius="16">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Kullanıcı Bilgileri"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <Grid Grid.Row="1"
                  Margin="0,0,0,14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Kullanıcı:"
                           Foreground="#B9CBE5"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="KullaniciAdiTextBox"
                         Grid.Column="1"
                         Height="34"
                         Padding="10,5"
                         Foreground="White"
                         Background="#263A5C"
                         BorderBrush="#405879"
                         BorderThickness="1"
                         FontSize="13"/>

            </Grid>

            <Grid Grid.Row="2"
                  Margin="0,0,0,12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Rol:"
                           Foreground="#B9CBE5"/>

                <TextBlock Grid.Column="1"
                           Text="Filo Yöneticisi"
                           Foreground="White"
                           FontWeight="SemiBold"/>

            </Grid>

            <Grid Grid.Row="3"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Sistem:"
                           Foreground="#B9CBE5"/>

                <TextBlock Grid.Column="1"
                           Text="FiloYenile Karar Destek Sistemi"
                           Foreground="White"
                           TextWrapping="Wrap"/>

            </Grid>

            <Button Grid.Row="4"
                    Content="Kaydet"
                    Width="110"
                    Height="36"
                    HorizontalAlignment="Right"
                    Foreground="White"
                    Background="#397CFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="KaydetButonu_Click"/>

        </Grid>

    </Border>

</Window>