<Window x:Class="FiloYenile.Gorunumler.RaporlarGorunumu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raporlar"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#111A2E">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

   
        <StackPanel>
            <TextBlock Text="Raporlar"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Filonun genel durumunu ve maliyet özetini inceleyin."
                       Foreground="#91A6C7"
                       FontSize="13"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,25,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="18"
                    CornerRadius="16"
                    Background="#CC1A2740"
                    BorderBrush="#405577"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Toplam Araç"
                               Foreground="#AFC0D9"
                               FontSize="12"/>

                    <TextBlock x:Name="ToplamAracText"
                               Text="0"
                               Foreground="#68A7FF"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Margin="8,0"
                    Padding="18"
                    CornerRadius="16"
                    Background="#CC1A2740"
                    BorderBrush="#405577"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Aktif Araç"
                               Foreground="#AFC0D9"
                               FontSize="12"/>

                    <TextBlock x:Name="AktifAracText"
                               Text="0"
                               Foreground="#22D3EE"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Margin="8,0"
                    Padding="18"
                    CornerRadius="16"
                    Background="#CC1A2740"
                    BorderBrush="#405577"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Toplam Bakım Maliyeti"
                               Foreground="#AFC0D9"
                               FontSize="12"/>

                    <TextBlock x:Name="ToplamBakimMaliyetiText"
                               Text="₺0"
                               Foreground="#B69BFF"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="3"
                    Margin="8,0,0,0"
                    Padding="18"
                    CornerRadius="16"
                    Background="#CC1A2740"
                    BorderBrush="#405577"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Toplam Yakıt Maliyeti"
                               Foreground="#AFC0D9"
                               FontSize="12"/>

                    <TextBlock x:Name="ToplamYakitMaliyetiText"
                               Text="₺0"
                               Foreground="#F59E0B"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0"/>
                </StackPanel>

            </Border>

        </Grid>

    
        <Border Grid.Row="2"
                CornerRadius="18"
                Background="#CC1A2740"
                BorderBrush="#405577"
                BorderThickness="1"
                Padding="15">

            <DataGrid x:Name="RaporTablosu"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      Foreground="#E8EFFA"
                      BorderThickness="0"
                      RowBackground="#1D2B45"
                      AlternatingRowBackground="#22324F"
                      HorizontalGridLinesBrush="#344968"
                      RowHeight="50">

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#263A5C"/>
                        <Setter Property="Foreground" Value="#B9CBE5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Foreground" Value="#E8EFFA"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Plaka"
                                        Binding="{Binding Plaka}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Araç"
                                        Binding="{Binding Marka}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Model"
                                        Binding="{Binding Model}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Kilometre"
                                        Binding="{Binding Kilometre}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Bakım Maliyeti"
                                        Binding="{Binding YillikBakimMaliyeti}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Yakıt Maliyeti"
                                        Binding="{Binding YillikYakitMaliyeti}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Araç Değeri"
                                        Binding="{Binding GuncelDeger}"
                                        Width="1.2*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>