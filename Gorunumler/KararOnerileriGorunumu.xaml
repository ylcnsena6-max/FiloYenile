<Window x:Class="FiloYenile.Gorunumler.KararOnerileriGorunumu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Karar Önerileri"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#111A2E">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


       
        <StackPanel Grid.Row="0">

            <TextBlock Text="Karar Önerileri"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="AHP ve TOPSIS yöntemlerine göre araç yenileme öncelikleri."
                       Foreground="#91A6C7"
                       FontSize="13"
                       Margin="0,6,0,0"/>

        </StackPanel>


       
        <Border Grid.Row="1"
                Margin="0,25,0,18"
                Padding="18"
                CornerRadius="16"
                Background="#CC1A2740"
                BorderBrush="#405577"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Araç Yenileme Analizi"
                               Foreground="#DCE8F8"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Yüksek skor, aracın yenilenme önceliğinin daha yüksek olduğunu gösterir."
                               Foreground="#91A6C7"
                               FontSize="11"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <Border Grid.Column="1"
                        Background="#263A5C"
                        CornerRadius="10"
                        Padding="14,8"
                        VerticalAlignment="Center">

                    <TextBlock Text="AHP + TOPSIS"
                               Foreground="#68A7FF"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                </Border>

            </Grid>

        </Border>


     
        <Border Grid.Row="2"
                CornerRadius="18"
                Background="#CC1A2740"
                BorderBrush="#405577"
                BorderThickness="1"
                Padding="15">

            <DataGrid x:Name="KararTablosu"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      Foreground="#E8EFFA"
                      BorderThickness="0"
                      RowBackground="#1D2B45"
                      AlternatingRowBackground="#22324F"
                      HorizontalGridLinesBrush="#344968"
                      RowHeight="52">

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="#263A5C"/>

                        <Setter Property="Foreground"
                                Value="#B9CBE5"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="Padding"
                                Value="10"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Setter Property="Padding"
                                Value="10"/>

                        <Setter Property="Foreground"
                                Value="#E8EFFA"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                    </Style>

                </DataGrid.Resources>


                <DataGrid.Columns>

                   
                    <DataGridTextColumn Header="Sıra"
                                        Binding="{Binding Sira}"
                                        Width="80"/>



                    <DataGridTextColumn Header="Plaka"
                                        Binding="{Binding Arac.Plaka}"
                                        Width="1.2*"/>


                    
                    <DataGridTextColumn Header="Marka"
                                        Binding="{Binding Arac.Marka}"
                                        Width="*"/>


             
                    <DataGridTextColumn Header="Model"
                                        Binding="{Binding Arac.Model}"
                                        Width="*"/>


            
                    <DataGridTextColumn Header="Model Yılı"
                                        Binding="{Binding Arac.ModelYili}"
                                        Width="*"/>


                    
                    <DataGridTextColumn Header="TOPSIS Skoru"
                                        Binding="{Binding TopsisSkoru, StringFormat={}{0:F3}}"
                                        Width="1.2*"/>


             
                    <DataGridTextColumn Header="Yenileme %"
                                        Binding="{Binding YenilemeYuzdesi, StringFormat={}{0:F1}%}"
                                        Width="1.2*"/>


                    
                    <DataGridTemplateColumn Header="Öncelik"
                                            Width="130">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border CornerRadius="10"
                                        Padding="10,5"
                                        HorizontalAlignment="Center">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background"
                                                    Value="#344968"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding OncelikSeviyesi}"
                                                             Value="Kritik">

                                                    <Setter Property="Background"
                                                            Value="#8B3345"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding OncelikSeviyesi}"
                                                             Value="Yüksek">

                                                    <Setter Property="Background"
                                                            Value="#7A5430"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding OncelikSeviyesi}"
                                                             Value="Orta">

                                                    <Setter Property="Background"
                                                            Value="#425D86"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding OncelikSeviyesi}"
                                                             Value="Düşük">

                                                    <Setter Property="Background"
                                                            Value="#315D59"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock Text="{Binding OncelikSeviyesi}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>