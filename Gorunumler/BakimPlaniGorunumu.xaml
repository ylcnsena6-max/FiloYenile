<Window x:Class="FiloYenile.Gorunumler.BakimPlaniGorunumu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bakım Planı"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#111A2E">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Bakım Planı"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Araçların bakım durumunu ve bakım önceliğini takip edin."
                       Foreground="#91A6C7"
                       FontSize="13"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,25,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="20"
                    CornerRadius="16"
                    Background="#CC1A2740"
                    BorderBrush="#405577"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Toplam Araç"
                               Foreground="#AFC0D9"
                               FontSize="12"/>

                    <TextBlock x:Name="ToplamAracText"
                               Text="0"
                               Foreground="#68A7FF"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Margin="10,0"
                    Padding="20"
                    CornerRadius="16"
                    Background="#CC1A2740"
                    BorderBrush="#405577"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Bakım Öncelikli"
                               Foreground="#AFC0D9"
                               FontSize="12"/>

                    <TextBlock x:Name="BakimOncelikliText"
                               Text="0"
                               Foreground="#F59E0B"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Margin="10,0,0,0"
                    Padding="20"
                    CornerRadius="16"
                    Background="#CC1A2740"
                    BorderBrush="#405577"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Kritik Araç"
                               Foreground="#AFC0D9"
                               FontSize="12"/>

                    <TextBlock x:Name="KritikAracText"
                               Text="0"
                               Foreground="#EF5B5B"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

        </Grid>

        <Border Grid.Row="2"
                CornerRadius="18"
                Background="#CC1A2740"
                BorderBrush="#405577"
                BorderThickness="1"
                Padding="15">

            <DataGrid x:Name="BakimTablosu"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      Foreground="#E8EFFA"
                      BorderThickness="0"
                      RowBackground="#1D2B45"
                      AlternatingRowBackground="#22324F"
                      HorizontalGridLinesBrush="#344968"
                      RowHeight="50">

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#263A5C"/>
                        <Setter Property="Foreground" Value="#B9CBE5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Foreground" Value="#E8EFFA"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Plaka"
                                        Binding="{Binding Plaka}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Marka"
                                        Binding="{Binding Marka}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Model"
                                        Binding="{Binding Model}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Kilometre"
                                        Binding="{Binding Kilometre}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Arıza Sayısı"
                                        Binding="{Binding ArizaSayisi}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Bakım Maliyeti"
                                        Binding="{Binding YillikBakimMaliyeti}"
                                        Width="1.3*"/>

                    <DataGridTemplateColumn Header="Bakım Durumu"
                                            Width="150">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Border CornerRadius="10"
                                        Padding="10,5"
                                        HorizontalAlignment="Center">

                                    <Border.Style>
                                        <Style TargetType="Border">

                                            <Setter Property="Background"
                                                    Value="#315D59"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding ArizaSayisi}"
                                                             Value="5">
                                                    <Setter Property="Background"
                                                            Value="#7A5430"/>
                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </Border.Style>

                                    <Button Content="Kontrol Et"
        Width="90"
        Height="30"
        Background="#397CFF"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand"
        Click="KontrolEtButonu_Click"/>
                                    
                                </Border>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>