<Window x:Class="FiloYenile.Gorunumler.AraclarGorunumu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Araçlar"
        Width="1300"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#111A2E">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

      
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Araçlar"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Filodaki araçları görüntüleyin ve yönetin."
                           Foreground="#91A6C7"
                           FontSize="13"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="+  Yeni Araç Ekle"
                    Width="150"
                    Height="42"
                    Background="#397CFF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="YeniAracButonu_Click"/>

        </Grid>


      
        <Border Grid.Row="1"
                Margin="0,25,0,18"
                Padding="18"
                CornerRadius="16"
                Background="#CC1A2740"
                BorderBrush="#405577"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Filo Araç Listesi"
                               Foreground="#DCE8F8"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Kayıtlı araçların güncel bilgileri"
                               Foreground="#91A6C7"
                               FontSize="11"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Araç Yönetimi"
                           Foreground="#68A7FF"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <Border Grid.Row="2"
                CornerRadius="18"
                Background="#CC1A2740"
                BorderBrush="#405577"
                BorderThickness="1"
                Padding="15">

            <DataGrid x:Name="AracTablosu"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      Foreground="#E8EFFA"
                      BorderThickness="0"
                      RowBackground="#1D2B45"
                      AlternatingRowBackground="#22324F"
                      HorizontalGridLinesBrush="#344968"
                      RowHeight="48">

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#263A5C"/>
                        <Setter Property="Foreground" Value="#B9CBE5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Foreground" Value="#E8EFFA"/>
                    </Style>

                </DataGrid.Resources>


                <DataGrid.Columns>

                    <DataGridTextColumn Header="Plaka"
                                        Binding="{Binding Plaka}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Marka"
                                        Binding="{Binding Marka}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Model"
                                        Binding="{Binding Model}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Model Yılı"
                                        Binding="{Binding ModelYili}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Kilometre"
                                        Binding="{Binding Kilometre}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Yakıt"
                                        Binding="{Binding YakitTuru}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Bakım Maliyeti"
                                        Binding="{Binding YillikBakimMaliyeti}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Yakıt Maliyeti"
                                        Binding="{Binding YillikYakitMaliyeti}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Arıza"
                                        Binding="{Binding ArizaSayisi}"
                                        Width="0.7*"/>

                    <DataGridTextColumn Header="Araç Değeri"
                                        Binding="{Binding GuncelDeger}"
                                        Width="1.2*"/>

                    <DataGridCheckBoxColumn Header="Aktif"
                                            Binding="{Binding AktifMi}"
                                            Width="0.7*"/>


                    <DataGridTemplateColumn Header="İşlemler"
                                            Width="180">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Button Content="Düzenle"
                                            Width="75"
                                            Height="30"
                                            Margin="0,0,8,0"
                                            Background="#397CFF"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="DuzenleButonu_Click"/>

                                    <Button Content="Sil"
                                            Width="65"
                                            Height="30"
                                            Background="#EF5B5B"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="SilButonu_Click"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>